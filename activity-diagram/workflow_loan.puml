@startuml
|Secretary / Coordinator|
start
if (Student is in loan program?) then (Yes)
  :Select institution;
  :Create loan agreement;
  :Upload agreement document;
else (No)
  stop
endif
:Record disbursement amount & date;
if (Overdraft?) then (Blocked)
  stop
endif

:Monitor student until graduation;
if (Graduated?) then (Yes)
  :Change status to Refunding;
else (No)
  stop
endif

repeat
  :Record repayment amount & date;
  :Calculate remaining balance;
repeat while (Balance > 0?) is (Yes)

|System|
:Mark loan complete;
:Log to audit trail;
stop
@enduml
