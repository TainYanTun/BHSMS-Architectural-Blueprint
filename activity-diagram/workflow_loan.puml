@startuml
|Secretary|
start
:Select student;
:Create loan agreement;
:Upload agreement document;

|Coordinator|
:Record disbursement amount & date;
:Monitor student until graduation;
if (Graduated?) then (No)
  stop
endif
:Change status to Refunding;

repeat
  :Record repayment amount & date;
  :Calculate remaining balance;
repeat while (Balance > 0?) is (Yes)

|System|
:Mark loan complete;
:Log to audit trail;
stop
@enduml
