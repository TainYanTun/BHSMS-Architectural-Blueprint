@startuml
skinparam conditionStyle inside

|Director|
start
:Establish loan agreement;

|Program Coordinator|
repeat
  :Record payout;
  :Select payment category;
  :Click submit;
|System|
  :Deduct from loan balance;
|Program Coordinator|
  :Track student progress;
repeat while (Student studying?) is (Yes) not (No)

|Director|
:Confirm graduation or dropout;

|Program Coordinator|cd
:Inform student of repayment amount;

|System|
:Start 6-month grace period timer;
:Wait for grace period to expire;
:Activate repayment schedule;
repeat

if (Payment logged within 12-month deadline?) then (No)
  :Mark loan as overdue;
  :Flag the student;

  stop
else (Yes)
  :Mark loan as repaying;
endif

|Secretary|
:Record payment;
:Select type;
:Click submit;

|System|
:Create/Update balance;
:Log audit entry;
if (Tracked Balance > 0?) then (Yes)
  else
  |System|
  :Mark loan as repaid;
  stop
endif
repeat while (Tracked Balance > 0)
@enduml