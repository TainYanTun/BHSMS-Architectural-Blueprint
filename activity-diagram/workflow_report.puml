@startuml
|Secretary|
start
:Select student;
:Select report type;

if (Case history?) then (Yes)
  :Add student photo;
endif

if (Use template? (optional)) then (Yes)
  :Choose template;
endif

:Write narrative;
:Review draft;
:Submit for approval;


|Director|
if (Approve?) then (No)
  :Write feedback;
  |Secretary|
  :Revise report;
  :Resubmit for approval;
  kill
else (Yes)
  |Director|
  :Sign off;
endif

|System|
:Queue PDF generation;
:Render PDF;
:Sent and notify HQ Staff;
:Store to object storage;
:Log to audit trail;
stop
@enduml
