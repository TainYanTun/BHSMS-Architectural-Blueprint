graph TD
    %% --- STREAMLINED FRONTEND LAYER ---
    subgraph ClientLayer ["Client Layer (React + Vite)"]
        SP["Sponsor Portal <br/> (Public Cloud / SPA)"]
        ST["Staff Portal <br/> (Tailscale / Sandbox UI Preview Mode)"]
    end

    %% --- INFRASTRUCTURE & PROXY ---
    subgraph RP ["Ingress & Reverse Proxy Layer"]
        Proxy["Reverse Proxy <br/> (Nginx: SSL, Rate Limiting)"]
    end

    Cache[("Caching & Queue Broker <br/> (Redis)")]

    %% --- CORE APP LAYER ---
    subgraph SL ["Service Layer (Laravel 11 REST API)"]
        Auth["API Gateway <br/> (Sanctum Tokens + RBAC Middleware)"]
        Sched["Laravel Automation Engine <br/> (Artisan Scheduler)"]
        Logic["Domain Logic <br/> (Services / Eloquent Models)"]
        Jobs["Background Queue <br/> (PDFs, Mail, Sync Workers)"]
        
        Auth -->|Validate FormRequests| Logic
        Sched -->|Triggers Periodic| Logic
    end

    %% --- MIGRATION PIPELINE (ETL with Gatekeeper) ---
    Legacy[(Legacy MS Access <br/> & Paper Files)]
    
    subgraph ETL ["Migration Engine (ETL Pipeline)"]
        Ext["Extract <br/> (File Parsers & DB Connectors)"]
        Trans["Transform & Validate <br/> (Schema Mapping & Data Cleansing)"]
        Stage[("Isolated Sandbox <br/> (Ephemeral Draft Records)")]
        
        Ext --> Trans
        Trans -->|Write Draft| Stage
    end

    %% --- THE GATEKEEPER ---
    Gate[["Sandbox Preview <br/> (Visual UI Evaluation & Confirmation)"]]

    %% --- DATA & PERSISTENCE ---
    subgraph DL ["Data Layer (Persistence)"]
        DB[("PostgreSQL Production <br/> (Partitioned Audit Logs)")]
        File["Object Storage <br/> (S3 / Student Photos / PDFs)"]
    end

    %% --- OUTBOUND ---
    ExtS[(External SMTP <br/> & SMS Gateway)]

    %% ==========================================
    %% DATA FLOW PIPELINES
    %% ==========================================
    
    %% Ingress Flow
    SP & ST -->|HTTPS| Proxy
    Proxy -->|PHP-FPM| Auth

    %% Migration / ETL Flow with Gatekeeper
    Legacy -.->|Raw Data / OCR| Ext
    Stage -->|Read Draft Records | Gate
    Gate -->|Approved Manual Release| DB

    %% Caching & Queue Brokerage
    Logic <-->|Read/Write Cache <br/> & Dispatch Jobs| Cache
    Cache -->|Poll Tasks| Jobs

    %% Persistence & Outbound Pipelines
    Logic -->|ORM Write / Audit Trail| DB
    Jobs -->|Update State / Log| DB 
    Jobs -->|Store Media| File 
    Jobs -->|Send| ExtS

    Logic -->|Transform to UI Preview| Gate