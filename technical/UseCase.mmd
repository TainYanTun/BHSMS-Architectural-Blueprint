    %% ── SPONSOR ──
    Spo --> SC1
    Spo --> SP3
    Spo --> DC1 & DC2 & DC3

    %% ── RELATIONSHIPS ──
    SC6 -.->|extends| SC5
    DC3 -.->|includes| DC1
    DC2 -.->|includes| DC4
