usecaseDiagram
    actor Secretary as "Secretary"
    actor Coordinator as "Coordinator²"
    actor Director as "Director"
    actor Admin as "Admin"
    actor Sponsor as "Sponsor"

    note right of Coordinator
        ² Access scoped to assigned
        program(s) via user_programs
    end note

    usecase SC1 as "Manage Student Records"
    usecase SC2 as "Manage Academic Records"
    usecase SC3 as "Manage Attendance"
    usecase SC4 as "Add Student History / Notes"
    usecase SC5 as "Request Program Transition"
    usecase SC6 as "Drop / Complete Student"

    usecase SP1 as "Manage Sponsors"
    usecase SP2 as "Manage Sponsorships"
    usecase SP3 as "View Sponsorship Income"

    usecase FN1 as "Record Contributions"
    usecase FN2 as "Manage Student Subsidies"
    usecase FN3 as "Manage Higher Ed Loans"
    usecase FN4 as "Reconcile Finances"
    usecase FN5 as "View Audit Logs"

    usecase DC1 as "Upload Documents"
    usecase DC2 as "Send Thank You Letters"
    usecase DC3 as "Generate APR"
    usecase DC4 as "Manage Communications"
    usecase DC5 as "Manage Templates"

    usecase SA1 as "Manage Users & Roles"
    usecase SA2 as "Send Invitations"
    usecase SA3 as "Manage Facilities"
    usecase SA4 as "Manage Teachers"
    usecase SA5 as "Perform Data Migration"
    usecase SA6 as "View System Health"
    usecase SA7 as "Manage Backups"

    Secretary --> SC1
    Secretary --> SC2
    Secretary --> SC3
    Secretary --> SC4
    Secretary --> SP1
    Secretary --> SP2
    Secretary --> SP3
    Secretary --> FN1
    Secretary --> FN3
    Secretary --> DC1
    Secretary --> DC2

    Coordinator --> SC1
    Coordinator --> SC2
    Coordinator --> SC3
    Coordinator --> SC4
    Coordinator --> SC5
    Coordinator --> SP1
    Coordinator --> SP2
    Coordinator --> SP3
    Coordinator --> FN2
    Coordinator --> FN3
    Coordinator --> DC1
    Coordinator --> DC2
    Coordinator --> SA4

    Director --> SC5
    Director --> SC6
    Director --> SP1
    Director --> SP2
    Director --> SP3
    Director --> FN4
    Director --> FN5
    Director --> DC3
    Director --> DC4
    Director --> SA2

    Admin --> FN5
    Admin --> DC5
    Admin --> SA1
    Admin --> SA2
    Admin --> SA3
    Admin --> SA5
    Admin --> SA6
    Admin --> SA7

    Sponsor --> SC1
    Sponsor --> SP3
    Sponsor --> DC1
    Sponsor --> DC2
    Sponsor --> DC3

    SC6 <.. SC5 : extends
    DC3 <.. DC1 : includes
    DC2 <.. DC4 : includes
