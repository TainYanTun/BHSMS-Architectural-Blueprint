        SC1["Manage Student Records"]
        SC2["Manage Academic Records"]
        SC3["Manage Attendance"]
        SC4["Add Student History / Notes"]
        SC5["Request Program Transition"]
        SC6["Drop / Complete Student"]
    end

    %% ── SPONSORSHIP ──
    subgraph Sponsorship["Sponsorship"]
        SP1["Manage Sponsors"]
        SP2["Manage Sponsorships"]
        SP3["View Sponsorship Income"]
