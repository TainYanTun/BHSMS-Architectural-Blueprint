    %% ── FINANCIAL ──
    subgraph Financial["Financial"]
        FN1["Record Contributions"]
        FN2["Manage Student Subsidies"]
        FN3["Manage Higher Ed Loans"]
        FN4["Reconcile Finances"]
        FN5["View Audit Logs"]
    end

    %% ── DOCUMENTS & COMMUNICATIONS ──
    subgraph DocComm["Documents & Communications"]
        DC1["Upload Documents"]
        DC2["Send Thank You Letters"]
        DC3["Generate APR"]
        DC4["Manage Communications"]
        DC5["Manage Templates"]
    end

    %% ── SYSTEM ADMINISTRATION ──
    subgraph SysAdmin["System Administration"]
